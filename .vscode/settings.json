{
  // build/ chega a alguns GB e dezenas de milhares de arquivos (sysroot
  // MinGW, cache do flatpak-builder, dist do Windows) durante um build —
  // sem essas exclusões o watcher de arquivos do VS Code tenta acompanhar
  // tudo isso em tempo real e trava a janela inteira. python/ e testes/
  // são resíduos de antes da reescrita em Go (não rastreados, mas ainda
  // no disco); .flatpak-builder/ e vendor/ são gerados, do mesmo jeito.
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.flatpak-builder/**": true,
    "**/vendor/**": true,
    "**/python/**": true,
    "**/testes/**": true
  },
  "files.exclude": {
    "**/.flatpak-builder": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.flatpak-builder": true,
    "**/vendor": true,
    "**/python": true,
    "**/testes": true
  },
  // watcherExclude/search.exclude não impedem o Pylance de indexar
  // python/: ele é quem estava consumindo a CPU toda, mesmo com a janela
  // parada. Isto aqui é o que de fato tira a pasta do radar dele.
  "python.analysis.exclude": [
    "**/python/**",
    "**/testes/**",
    "**/build/**",
    "**/.flatpak-builder/**",
    "**/vendor/**"
  ],
  // O gopls também ignora as exclusões do editor e varre o diretório por
  // conta própria — chegou a passar de 900% de CPU. Sintaxe própria: o
  // prefixo "-" exclui o diretório a partir da raiz do workspace.
  //
  // GOWORK=off (2026-11-07, de novo a 1000% de CPU): o go.work local põe
  // third_party/gio e third_party/vt10x como módulos DO WORKSPACE, e isso
  // passa por cima do directoryFilters — a cada build (que regenera o
  // vendor/) ele reindexava o Gio inteiro. O go.mod já aponta para os dois
  // pelo replace, então o gopls continua achando o código deles, só que
  // como dependência: carrega o que o app usa, não o fork inteiro.
  "gopls": {
    "build.env": {
      "GOWORK": "off"
    },
    "build.directoryFilters": [
      "-build",
      "-.flatpak-builder",
      "-vendor",
      "-third_party",
      "-python",
      "-testes"
    ]
  }
}
